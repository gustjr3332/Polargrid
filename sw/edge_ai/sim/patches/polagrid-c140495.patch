index a8e2200..2ebf242 100644
--- a/source/server/httpd.c
+++ b/source/server/httpd.c
@@ -29,6 +29,9 @@ static void respond(int);
 extern void route(oneM2MPrimitive *o2pt);
 
 static char *buf[MAX_CONNECTIONS];
+// tinyIoT handles each request in its own thread but the resource tree (rtnode->obj) is not thread safe:
+// concurrent create/fopt crashed in get_ri_rtnode(). Serialize request routing.
+static pthread_mutex_t route_lock = PTHREAD_MUTEX_INITIALIZER;
 
 // Client request
 
@@ -444,7 +447,9 @@ void handle_http_request(HTTPRequest *req, int slotno)
         o2pt->fc = qs;
     }
 
+    pthread_mutex_lock(&route_lock);
     route(o2pt);
+    pthread_mutex_unlock(&route_lock);
 
     http_respond_to_client(o2pt, slotno);
     free_o2pt(o2pt);
